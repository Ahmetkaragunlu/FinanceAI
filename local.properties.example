# Copy these entries to ignored local.properties; do not commit real values.
sdk.dir=/path/to/Android/sdk
MAPS_API_KEY=your-restricted-android-maps-key
# Alternatively provide MAPS_API_KEY via an environment variable or Gradle property in CI.
AI_FIREBASE_PROJECT_ID=your-ai-firebase-project-id
AI_FIREBASE_APP_ID=your-ai-firebase-android-app-id
AI_FIREBASE_API_KEY=your-restricted-ai-firebase-client-key
# AI values also accept environment variables or Gradle properties in CI.
