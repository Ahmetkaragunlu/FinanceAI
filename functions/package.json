{
  "name": "financeai-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/auth/*.test.js test/schedule/*.test.js",
    "test:rules": "node --test test/rules/*.test.js",
    "check": "for file in index.js src/*.js src/auth/*.js src/schedule/*.js; do node --check \"$file\" || exit $?; done"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "3.5.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
